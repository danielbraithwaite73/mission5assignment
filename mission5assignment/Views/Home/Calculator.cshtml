
@{
    ViewBag.Title = "Tutor Calculator";
}

<h2>Tutor Service Calculator</h2>
<hr />

<div class="calculator-container">
    <div class="form-group">
        <label>Hourly Rate ($):</label>
        <input type="text" id="hourlyRate" value="50" readonly class="form-control" style="background-color: #eee;" />
    </div>

    <div class="form-group">
        <label>Number of Hours:</label>
        <input type="number" id="hoursNeeded" placeholder="Enter hours" class="form-control" />
        <span id="error-message" style="color: red; display: none;">Please enter a positive number.</span>
    </div>

    <br />
    <button id="btnCalculate" class="btn btn-primary">Calculate Total</button>
    <br /><br />

    <div class="form-group">
        <label>Total Cost ($):</label>
        <input type="text" id="totalCost" readonly class="form-control" />
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="~/js/calculator.js"></script>